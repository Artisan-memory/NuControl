#: src/bot/handlers/user_commands.py:117
msgid ""
"<b>Available commands:</b>\n"
"\n"
"<b>/shutdown</b> or <b>/s</b> — shut down the computer\n"
"<b>/reboot</b> or <b>/r</b> — restart the computer\n"
"<b>/hibernate</b> or <b>/h</b> — put the computer to sleep\n"
"<b>/lock</b> or <b>/l</b> — lock the computer\n"
"<b>/logout</b> — log out of the current session\n"
"<b>/cancel</b> — cancel scheduled actions (shutdown, reboot, hibernate)\n"
"<b>/check</b> — check the computer status\n"
"<b>/cpu</b> — same as /check, but concise\n"
"<b>/launch</b> <i>program</i> — launch a program (e.g. <code>/launch notepad</code>)\n"
"<b>/link</b> <i>url</i> — open a link (e.g. <code>/link google.com</code>)\n"
"<b>/task</b> <i>process</i> — check whether a process is running or stop it (e.g. "
"<code>/task chrome</code>)\n"
"<b>/screen</b> — take a screenshot\n"
"<b>/keyboard</b> or <b>/kb</b> — show the keyboard\n"
"<b>/webcam</b> or <b>/web</b> or <b>/photo</b> — capture a webcam image\n"
"<b>/download</b> <i>path</i> — send a file from the computer (e.g. <code>/download "
"C:/file.txt</code>)\n"
"<b>/say</b> <i>text</i> — speak the text through the speakers (e.g. <code>/say Hello "
"World!</code>)\n"
"<b>/clipboard</b> [<i>text</i>] — show or set the clipboard contents\n"
"<b>/wifi</b> — show SSID and password of saved Wi-Fi networks\n"
"<b>/ls</b> — browse the current directory, tap a name to open or download it\n"
"<b>/cd</b> <i>path</i> — change the current directory\n"
"<b>/msg</b> <i>text</i> — show a message box on the PC screen\n"
"<b>/lang</b> — change the bot language\n"
"\n"
"<b>Tip:</b> add a delay in minutes to shutdown/reboot/hibernate/lock, e.g. "
"<i>/shutdown 2</i>."
msgstr ""
"<b>Доступные команды:</b>\n"
"\n"
"<b>/shutdown</b> или <b>/s</b> — выключить компьютер\n"
"<b>/reboot</b> или <b>/r</b> — перезагрузить компьютер\n"
"<b>/hibernate</b> или <b>/h</b> — отправить компьютер в сон\n"
"<b>/lock</b> или <b>/l</b> — заблокировать компьютер\n"
"<b>/logout</b> — выйти из текущей учётной записи\n"
"<b>/cancel</b> — отменить запланированные действия (выключение, перезагрузка, "
"гибернация)\n"
"<b>/check</b> — состояние компьютера\n"
"<b>/cpu</b> — то же, что /check, только кратко\n"
"<b>/launch</b> <i>программа</i> — запустить программу (например <code>/launch "
"notepad</code>)\n"
"<b>/link</b> <i>ссылка</i> — открыть ссылку (например <code>/link google.com</code>)\n"
"<b>/task</b> <i>процесс</i> — проверить, запущен ли процесс, или остановить его "
"(например <code>/task chrome</code>)\n"
"<b>/screen</b> — сделать снимок экрана\n"
"<b>/keyboard</b> или <b>/kb</b> — показать клавиатуру\n"
"<b>/webcam</b> или <b>/web</b> или <b>/photo</b> — снимок с веб-камеры\n"
"<b>/download</b> <i>путь</i> — прислать файл с компьютера (например <code>/download "
"C:/file.txt</code>)\n"
"<b>/say</b> <i>текст</i> — произнести текст в динамики (например <code>/say "
"Привет!</code>)\n"
"<b>/clipboard</b> [<i>текст</i>] — показать или изменить буфер обмена\n"
"<b>/wifi</b> — показать SSID и пароли сохранённых Wi-Fi сетей\n"
"<b>/ls</b> — проводник по текущей папке, по имени можно открыть или скачать\n"
"<b>/cd</b> <i>путь</i> — сменить текущую папку\n"
"<b>/msg</b> <i>текст</i> — показать сообщение на экране ПК\n"
"<b>/lang</b> — сменить язык бота\n"
"\n"
"<b>Подсказка:</b> к shutdown/reboot/hibernate/lock можно добавить задержку в минутах,"
" например <i>/shutdown 2</i>."

