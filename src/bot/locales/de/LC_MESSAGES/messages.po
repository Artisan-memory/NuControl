#: src/bot/handlers/user_commands.py:117
msgid ""
"<b>Available commands:</b>\n"
"\n"
"<b>/shutdown</b> or <b>/s</b> — shut down the computer\n"
"<b>/reboot</b> or <b>/r</b> — restart the computer\n"
"<b>/hibernate</b> or <b>/h</b> — put the computer to sleep\n"
"<b>/lock</b> or <b>/l</b> — lock the computer\n"
"<b>/logout</b> — log out of the current session\n"
"<b>/cancel</b> — cancel scheduled actions (shutdown, reboot, hibernate)\n"
"<b>/check</b> — check the computer status\n"
"<b>/cpu</b> — same as /check, but concise\n"
"<b>/launch</b> <i>program</i> — launch a program (e.g. <code>/launch notepad</code>)\n"
"<b>/link</b> <i>url</i> — open a link (e.g. <code>/link google.com</code>)\n"
"<b>/task</b> <i>process</i> — check whether a process is running or stop it (e.g. "
"<code>/task chrome</code>)\n"
"<b>/screen</b> — take a screenshot\n"
"<b>/keyboard</b> or <b>/kb</b> — show the keyboard\n"
"<b>/webcam</b> or <b>/web</b> or <b>/photo</b> — capture a webcam image\n"
"<b>/download</b> <i>path</i> — send a file from the computer (e.g. <code>/download "
"C:/file.txt</code>)\n"
"<b>/say</b> <i>text</i> — speak the text through the speakers (e.g. <code>/say Hello "
"World!</code>)\n"
"<b>/clipboard</b> [<i>text</i>] — show or set the clipboard contents\n"
"<b>/wifi</b> — show SSID and password of saved Wi-Fi networks\n"
"<b>/ls</b> — browse the current directory, tap a name to open or download it\n"
"<b>/cd</b> <i>path</i> — change the current directory\n"
"<b>/msg</b> <i>text</i> — show a message box on the PC screen\n"
"<b>/lang</b> — change the bot language\n"
"\n"
"<b>Tip:</b> add a delay in minutes to shutdown/reboot/hibernate/lock, e.g. "
"<i>/shutdown 2</i>."
msgstr ""
"<b>Verfügbare Befehle:</b>\n"
"\n"
"<b>/shutdown</b> oder <b>/s</b> — den Computer herunterfahren\n"
"<b>/reboot</b> oder <b>/r</b> — den Computer neu starten\n"
"<b>/hibernate</b> oder <b>/h</b> — den Computer in den Ruhezustand versetzen\n"
"<b>/lock</b> oder <b>/l</b> — den Computer sperren\n"
"<b>/logout</b> — von der aktuellen Sitzung abmelden\n"
"<b>/cancel</b> — geplante Aktionen abbrechen (Herunterfahren, Neustart, Ruhezustand)\n"
"<b>/check</b> — Status des Computers\n"
"<b>/cpu</b> — wie /check, aber kurz\n"
"<b>/launch</b> <i>Programm</i> — ein Programm starten (z. B. <code>/launch "
"notepad</code>)\n"
"<b>/link</b> <i>URL</i> — einen Link öffnen (z. B. <code>/link google.com</code>)\n"
"<b>/task</b> <i>Prozess</i> — prüfen, ob ein Prozess läuft, oder ihn beenden (z. B. "
"<code>/task chrome</code>)\n"
"<b>/screen</b> — ein Bildschirmfoto aufnehmen\n"
"<b>/keyboard</b> oder <b>/kb</b> — die Tastatur anzeigen\n"
"<b>/webcam</b> oder <b>/web</b> oder <b>/photo</b> — ein Webcam-Bild aufnehmen\n"
"<b>/download</b> <i>Pfad</i> — eine Datei vom Computer senden (z. B. <code>/download "
"C:/file.txt</code>)\n"
"<b>/say</b> <i>Text</i> — den Text über die Lautsprecher vorlesen (z. B. <code>/say "
"Hallo Welt!</code>)\n"
"<b>/clipboard</b> [<i>Text</i>] — die Zwischenablage anzeigen oder setzen\n"
"<b>/wifi</b> — SSID und Passwort gespeicherter WLANs anzeigen\n"
"<b>/ls</b> — das aktuelle Verzeichnis durchsuchen, ein Name öffnet oder lädt herunter"
"\n"
"<b>/cd</b> <i>Pfad</i> — das aktuelle Verzeichnis wechseln\n"
"<b>/msg</b> <i>Text</i> — ein Meldungsfenster am PC anzeigen\n"
"<b>/lang</b> — die Sprache des Bots ändern\n"
"\n"
"<b>Tipp:</b> shutdown/reboot/hibernate/lock nehmen eine Verzögerung in Minuten, z. B."
" <i>/shutdown 2</i>."

